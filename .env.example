# Tembo Agent Studio — v0.1 skeleton env reference.
# Copy to `.env` and fill in. Do not commit `.env`.

# ── Postgres ──────────────────────────────────────────────────────────────
# Used by both the Rust API (DATABASE_URL) and better-auth (via the web app).
POSTGRES_USER=tas
POSTGRES_PASSWORD=tas
POSTGRES_DB=tas
POSTGRES_PORT=5432

# ── Branding ──────────────────────────────────────────────────────────────
# Shown on the login screen and the signed-in header.
# Example: "ABC Company Agent Portal". Defaults to "Tembo Agent Studio".
TAS_INSTANCE_NAME=

# ── better-auth ───────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin where the web app is reachable. Used for cookie/session URLs.
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (sign-in) ────────────────────────────────────────────────
# Create OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# Until both are set, the login screen renders a "configuration needed" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Ports (host-side) ─────────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────
# Standard `env_logger` / `tracing-subscriber` filter syntax.
RUST_LOG=info,tas_api=debug
