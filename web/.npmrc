# pnpm v10's `minimum-release-age` policy rejects any dependency published
# within the last 24h. Sensible for ad-hoc installs, but it breaks reproducible
# builds whenever our pinned lockfile contains a recently-published transitive.
# The lockfile is the contract — review lockfile diffs in PRs instead of
# relying on a time-based heuristic.
minimum-release-age=0
